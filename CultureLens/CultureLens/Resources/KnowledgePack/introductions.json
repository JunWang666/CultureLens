{
  "introductions": [
    {
      "id": "3e6b47b2-a138-538e-971e-d6eebddc3a37",
      "key": "leifeng-pagoda.lake-landscape",
      "name": "雷峰塔的湖山位置",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "从西湖南岸看，雷峰塔以较厚重的塔身压住夕照山的轮廓。它适合从湖面和远岸辨认，重点不只是近看细部，而是观察塔、山与开阔水面的比例关系。"
          }
        ]
      },
      "culturalElementId": "359c601d-38fc-5368-ae98-929ad425dc77",
      "attractionId": "4019a709-1d10-5c3c-80fa-b97ebf90dd50",
      "latitude": 30.233889,
      "longitude": 120.145,
      "coordinateSourceUrl": "https://fr.wikipedia.org/wiki/Pagode_de_Leifeng"
    },
    {
      "id": "f36c5bce-648e-5bdd-b16d-fb5ff83be28b",
      "key": "leifeng-pagoda.evening-glow",
      "name": "雷峰夕照的观看提示",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“雷峰夕照”把地点与傍晚光线绑定。理解这一名称时，可以留意低角度日光如何强调塔的剪影，以及湖面亮度变化怎样把塔从山体背景中分离出来。"
          }
        ]
      },
      "culturalElementId": "891c98ae-bf30-5e71-ade3-03555e4c56ab",
      "attractionId": "4019a709-1d10-5c3c-80fa-b97ebf90dd50",
      "latitude": 30.233889,
      "longitude": 120.145,
      "coordinateSourceUrl": "https://fr.wikipedia.org/wiki/Pagode_de_Leifeng"
    },
    {
      "id": "5eaa664d-d529-5651-8b2a-02e3e2582412",
      "key": "baochu-pagoda.mountain-silhouette",
      "name": "宝石山上的保俶塔",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "保俶塔塔身瘦削，位于宝石山脊线上。与雷峰塔相比，它更像一枚细长的方向标；从湖东和北岸远望时，塔的价值主要体现在清晰轮廓与山势的对照。"
          }
        ]
      },
      "culturalElementId": "359c601d-38fc-5368-ae98-929ad425dc77",
      "attractionId": "d10ba550-da02-5864-b01a-d6430d8b587f",
      "latitude": 30.263333,
      "longitude": 120.143611,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q977249"
    },
    {
      "id": "75829842-ff34-50a3-babe-1f8ac8f94c4f",
      "key": "jingci-temple.temple-and-lake",
      "name": "净慈寺与西湖南岸佛教空间",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "净慈寺位于西湖南岸山麓，寺院、山体与湖边道路距离很近。到这里可以观察宗教空间并非远离城市，而是与游湖路线和日常交通持续交叠。"
          }
        ]
      },
      "culturalElementId": "e2d63219-cc30-5605-8cb5-e3795f3bf2aa",
      "attractionId": "972bbaf8-1b55-5043-8d74-d40856ab6492",
      "latitude": 30.23113,
      "longitude": 120.14434,
      "coordinateSourceUrl": "https://mapcarta.com/N4427428610"
    },
    {
      "id": "d525bc04-84b4-5d90-a14e-faa490e2fccf",
      "key": "jingci-temple.evening-bell",
      "name": "南屏晚钟的听觉景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“南屏晚钟”把声音也纳入西湖景观。它提醒人们，传统游赏并不只靠视觉：钟声的传播距离、山体回响和傍晚环境的安静程度，都会改变对地点的感受。"
          }
        ]
      },
      "culturalElementId": "891c98ae-bf30-5e71-ade3-03555e4c56ab",
      "attractionId": "972bbaf8-1b55-5043-8d74-d40856ab6492",
      "latitude": 30.23113,
      "longitude": 120.14434,
      "coordinateSourceUrl": "https://mapcarta.com/N4427428610"
    },
    {
      "id": "d2caaf04-e4f5-5cae-8b08-24c3bcf4c936",
      "key": "yue-fei-temple.memorial-space",
      "name": "岳王庙的纪念空间",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "岳王庙的参观重点不仅是识别某一座殿或墓，而是理解入口、祠庙、碑刻与墓园怎样组织出逐步强化的纪念秩序。空间路线本身就在引导态度和情绪。"
          }
        ]
      },
      "culturalElementId": "14e0dc6d-21b1-5512-ae11-f226f60b7d8d",
      "attractionId": "c89af010-e4a1-5d1c-a0df-54f116f748f5",
      "latitude": 30.257778,
      "longitude": 120.126111,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q579874"
    },
    {
      "id": "07f4bf11-1afc-5954-8cb4-1d75d9663ab0",
      "key": "wenlan-pavilion.imperial-library",
      "name": "文澜阁的藏书楼身份",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "文澜阁位于孤山文化设施密集的环境中。它的意义不只在园林外观，还在于作为《四库全书》藏书楼，把国家编纂工程落实为具体的收藏、保管与阅读空间。"
          }
        ]
      },
      "culturalElementId": "078a4b3d-92f8-54db-97eb-1f7a681d0ca3",
      "attractionId": "65265052-5508-57df-a81a-2c027576f5b7",
      "latitude": 30.253303,
      "longitude": 120.137856,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Wenlan_Pavilion"
    },
    {
      "id": "d7e19168-bb22-57af-a18d-57564cd50d6d",
      "key": "su-causeway.waterworks-and-walking",
      "name": "苏堤的水利与步行尺度",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "苏堤把疏浚、水面分隔和跨湖交通结合在一起。步行时可以留意桥与堤的交替：平直堤面提供连续方向，桥面抬高视点，让两侧湖面重新展开。"
          }
        ]
      },
      "culturalElementId": "085b790e-08f7-5811-8073-8c996202b225",
      "attractionId": "bad747f4-43a2-5202-8274-d549c7c45887",
      "latitude": 30.245833,
      "longitude": 120.133472,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "id": "080c1e07-2f6c-5b32-9ea6-f098fb7f8ee9",
      "key": "su-causeway.spring-dawn",
      "name": "苏堤春晓的时间感",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“苏堤春晓”强调早春与清晨，而不是固定建筑。堤上植物、薄雾、低亮度水面和逐渐苏醒的行人活动，共同构成这处景名的时间感。"
          }
        ]
      },
      "culturalElementId": "891c98ae-bf30-5e71-ade3-03555e4c56ab",
      "attractionId": "bad747f4-43a2-5202-8274-d549c7c45887",
      "latitude": 30.245833,
      "longitude": 120.133472,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "id": "52618e4a-f5cf-59db-b3f7-91e0ebeee174",
      "key": "three-pools-mirroring-moon.light-and-reflection",
      "name": "三潭印月的光与倒影",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭印月把小尺度塔形标志、灯光、水面和月色组合成夜间图像。理解它时可以区分实体、灯孔形成的亮点与水中倒影，体会景名如何让多层影像同时成立。"
          }
        ]
      },
      "culturalElementId": "8ddba328-608b-57b4-81bb-f383b22c1310",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q10866444"
    },
    {
      "id": "e50ff459-e171-5a7e-992f-f7ba07c026f2",
      "key": "three-pools-mirroring-moon.cultural-landscape",
      "name": "三潭映月与西湖文化景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "从三潭映月出发，可以把西湖理解为一座持续营造的文化景观：水面、岛屿、石塔、桥岸、植物和题名共同决定观看方式。重点不只是寻找一处“古迹”，而是观察自然与人工如何长期叠合。"
          }
        ]
      },
      "culturalElementId": "1b9523ce-d3e9-54b6-ac90-672593292b5d",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "id": "0fc4b65c-b063-59a7-9cfc-a5d766999852",
      "key": "three-pools-mirroring-moon.northern-song",
      "name": "三潭映月的北宋线索",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭石塔的历史线索可追溯到北宋元祐年间的西湖疏浚。现场理解时，可以把三座石塔同时看作水深标志、治理遗存和后来诗意景观的起点，不把今天的岛上园林全部倒推为北宋原貌。"
          }
        ]
      },
      "culturalElementId": "619e3ad2-bd4b-5901-9c76-9ddb454a83d3",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "id": "e109c1c8-4547-5878-96c4-805a0ce75590",
      "key": "three-pools-mirroring-moon.su-shi",
      "name": "苏轼：从疏浚到诗意景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "苏轼在杭州任职期间主持西湖疏浚，并以诗文留下对湖山的观看。三潭映月与苏堤可以并读：一条是水利治理和公共工程，一条是诗人如何把治理后的空间转化为可记忆、可传诵的景观。"
          }
        ]
      },
      "culturalElementId": "89a21706-5676-56aa-ab3c-6ab2b48991d8",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "id": "4984850e-31e7-5bbd-b809-e3c7ccc6dbba",
      "key": "three-pools-mirroring-moon.bai-juyi",
      "name": "白居易：西湖的唐代诗人传统",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "白居易留下的白堤传统提示我们，西湖的文化积累早于宋代。三潭映月虽然不是白居易营造的遗存，却可以沿着“诗人—水利—游赏”的线索，理解唐宋文人如何参与塑造西湖的文化记忆。"
          }
        ]
      },
      "culturalElementId": "a0a3e522-99bb-518b-9630-1d3e3f9dae16",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "id": "eeee2d35-c105-5659-89ca-2fc12619c671",
      "key": "three-pools-mirroring-moon.southern-song",
      "name": "南宋临安的景名传统",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“三潭印月”应放入南宋临安形成的西湖题名景观传统中阅读。四字景目把地点、季节、光线和情绪压缩为一句短语，使游湖从移动路线变成一组可吟咏、可绘画、可反复观看的场景。"
          }
        ]
      },
      "culturalElementId": "f097d527-52d8-568b-890c-1325f4b99a40",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.moj.gov.cn/pub/sfbgw/flfggz/flfggzdfzwgz/201006/t20100618_138397.html"
    },
    {
      "id": "7895336c-7682-5f85-9353-4947ec3b80dd",
      "key": "three-pools-mirroring-moon.song-aesthetics",
      "name": "宋代山水审美中的虚实",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭映月的魅力不在于“看见三个实体的月亮”，而在于实体石塔、灯孔亮点、月光和水中倒影之间的虚实转换。它提供了一个入口，理解宋代山水审美如何用有限景物生成更大的想象空间。"
          }
        ]
      },
      "culturalElementId": "c1d56f28-2b7d-5fa5-a66b-88b1a2288ee6",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "id": "c31a2f1e-e4f4-5eee-9f6d-883e5d48ebeb",
      "key": "three-pools-mirroring-moon.garden-framing",
      "name": "桥岸与树影形成的园林取景",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "在三潭映月行走时，桥洞、岸线、树木和亭台会不断改变视线边界。可以把这种经验理解为借景与框景：园林不只陈列对象，也通过路径和遮挡安排观看顺序，让湖山在不同位置呈现不同画面。"
          }
        ]
      },
      "culturalElementId": "3631f63f-a6de-5376-b4db-7e1128771edc",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "id": "47615e36-b590-5442-833b-8ef84236feb6",
      "key": "three-pools-mirroring-moon.xiaoyingzhou",
      "name": "小瀛洲：湖中有岛、岛中有湖",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "小瀛洲把岛外三潭与岛内水面、桥岸和园林路径组合起来，形成“湖中有岛、岛中有湖”的空间层次。三潭映月因此不只是远观三座石塔，也是一段在水面与园林之间转换尺度的行走经验。"
          }
        ]
      },
      "culturalElementId": "48063a9d-c070-5a3d-bb30-4a4ee8ec2486",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "id": "fe59359f-1898-578c-9d21-86c3d081f320",
      "key": "three-pools-mirroring-moon.reunion",
      "name": "从赏月到团圆想象",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "赏月在传统文化中常与团圆和寄情相连。三潭映月把这一情感主题转成空间体验：人在岸上或船上观看，月色、灯影和倒影彼此分离又重新合成，使“月”既是天体，也是被文化命名的共同想象。"
          }
        ]
      },
      "culturalElementId": "8ddba328-608b-57b4-81bb-f383b22c1310",
      "attractionId": "f4394af7-0206-5c20-a486-00d4d768e64a",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "id": "d071a36b-0e30-561e-80f5-1eaf6219633c",
      "key": "broken-bridge.snow",
      "name": "断桥残雪的观看方式",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "断桥所在的观看不是看桥体本身，而是看雪后黑白灰的湖面：桥面部分融化、部分存留时，桥身像被切开的断面。站在白堤东端，石桥、残雪和北里湖、外西湖的空间层次同时进入画面。"
          }
        ]
      },
      "culturalElementId": "7f3f6526-7e2a-5d1e-a8bd-a68fcc2ce405",
      "attractionId": "29584556-38e5-5478-b694-c4da40593c03",
      "latitude": 30.260833,
      "longitude": 120.146944,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/断桥残雪"
    },
    {
      "id": "def62c04-d9ad-505f-9268-f8ea872e3213",
      "key": "broken-bridge.whitesnake",
      "name": "断桥与《白蛇传》",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "《白蛇传》把断桥写成许仙与白娘子的相遇、相离与重逢的地点。故事与桥的石拱和湖水的呼应互相投射，使桥既是一座交通构筑，也成为戏曲游湖的舞台。"
          }
        ]
      },
      "culturalElementId": "4e92fdea-109e-5e69-b6bb-df6cb449ec01",
      "attractionId": "29584556-38e5-5478-b694-c4da40593c03",
      "latitude": 30.260833,
      "longitude": 120.146944,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/断桥"
    },
    {
      "id": "152dc22d-3846-5650-9fdf-9ce57669f849",
      "key": "pinghu-autumn-moon.moon",
      "name": "平湖秋月的秋夜月色",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "平湖秋月位于白堤西端的孤山之塘，面向外湖展开。秋夜湖面平静时月亮倒影完整，湖面的尺度成为观看主题。到平台或步道边体会湖、月、倒影三者顺序。"
          }
        ]
      },
      "culturalElementId": "8ddba328-608b-57b4-81bb-f383b22c1310",
      "attractionId": "52e6eb90-2187-5be7-872a-41651bfc9bb4",
      "latitude": 30.2545,
      "longitude": 120.141306,
