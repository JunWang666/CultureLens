{
  "introductions": [
    {
      "key": "leifeng-pagoda.lake-landscape",
      "name": "雷峰塔的湖山位置",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "从西湖南岸看，雷峰塔以较厚重的塔身压住夕照山的轮廓。它适合从湖面和远岸辨认，重点不只是近看细部，而是观察塔、山与开阔水面的比例关系。"
          }
        ]
      },
      "culturalElementKey": "west-lake-pagoda-landscape",
      "attractionKey": "leifeng-pagoda",
      "latitude": 30.233889,
      "longitude": 120.145,
      "coordinateSourceUrl": "https://fr.wikipedia.org/wiki/Pagode_de_Leifeng"
    },
    {
      "key": "leifeng-pagoda.evening-glow",
      "name": "雷峰夕照的观看提示",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“雷峰夕照”把地点与傍晚光线绑定。理解这一名称时，可以留意低角度日光如何强调塔的剪影，以及湖面亮度变化怎样把塔从山体背景中分离出来。"
          }
        ]
      },
      "culturalElementKey": "west-lake-ten-scenes",
      "attractionKey": "leifeng-pagoda",
      "latitude": 30.233889,
      "longitude": 120.145,
      "coordinateSourceUrl": "https://fr.wikipedia.org/wiki/Pagode_de_Leifeng"
    },
    {
      "key": "baochu-pagoda.mountain-silhouette",
      "name": "宝石山上的保俶塔",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "保俶塔塔身瘦削，位于宝石山脊线上。与雷峰塔相比，它更像一枚细长的方向标；从湖东和北岸远望时，塔的价值主要体现在清晰轮廓与山势的对照。"
          }
        ]
      },
      "culturalElementKey": "west-lake-pagoda-landscape",
      "attractionKey": "baochu-pagoda",
      "latitude": 30.263333,
      "longitude": 120.143611,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q977249"
    },
    {
      "key": "jingci-temple.temple-and-lake",
      "name": "净慈寺与西湖南岸佛教空间",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "净慈寺位于西湖南岸山麓，寺院、山体与湖边道路距离很近。到这里可以观察宗教空间并非远离城市，而是与游湖路线和日常交通持续交叠。"
          }
        ]
      },
      "culturalElementKey": "west-lake-buddhist-culture",
      "attractionKey": "jingci-temple",
      "latitude": 30.23113,
      "longitude": 120.14434,
      "coordinateSourceUrl": "https://mapcarta.com/N4427428610"
    },
    {
      "key": "jingci-temple.evening-bell",
      "name": "南屏晚钟的听觉景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“南屏晚钟”把声音也纳入西湖景观。它提醒人们，传统游赏并不只靠视觉：钟声的传播距离、山体回响和傍晚环境的安静程度，都会改变对地点的感受。"
          }
        ]
      },
      "culturalElementKey": "west-lake-ten-scenes",
      "attractionKey": "jingci-temple",
      "latitude": 30.23113,
      "longitude": 120.14434,
      "coordinateSourceUrl": "https://mapcarta.com/N4427428610"
    },
    {
      "key": "yue-fei-temple.memorial-space",
      "name": "岳王庙的纪念空间",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "岳王庙的参观重点不仅是识别某一座殿或墓，而是理解入口、祠庙、碑刻与墓园怎样组织出逐步强化的纪念秩序。空间路线本身就在引导态度和情绪。"
          }
        ]
      },
      "culturalElementKey": "yue-fei-memorial-culture",
      "attractionKey": "yue-fei-temple",
      "latitude": 30.257778,
      "longitude": 120.126111,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q579874"
    },
    {
      "key": "wenlan-pavilion.imperial-library",
      "name": "文澜阁的藏书楼身份",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "文澜阁位于孤山文化设施密集的环境中。它的意义不只在园林外观，还在于作为《四库全书》藏书楼，把国家编纂工程落实为具体的收藏、保管与阅读空间。"
          }
        ]
      },
      "culturalElementKey": "siku-quanshu-library",
      "attractionKey": "wenlan-pavilion",
      "latitude": 30.253303,
      "longitude": 120.137856,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Wenlan_Pavilion"
    },
    {
      "key": "su-causeway.waterworks-and-walking",
      "name": "苏堤的水利与步行尺度",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "苏堤把疏浚、水面分隔和跨湖交通结合在一起。步行时可以留意桥与堤的交替：平直堤面提供连续方向，桥面抬高视点，让两侧湖面重新展开。"
          }
        ]
      },
      "culturalElementKey": "west-lake-causeway-waterworks",
      "attractionKey": "su-causeway",
      "latitude": 30.245833,
      "longitude": 120.133472,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "key": "su-causeway.spring-dawn",
      "name": "苏堤春晓的时间感",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“苏堤春晓”强调早春与清晨，而不是固定建筑。堤上植物、薄雾、低亮度水面和逐渐苏醒的行人活动，共同构成这处景名的时间感。"
          }
        ]
      },
      "culturalElementKey": "west-lake-ten-scenes",
      "attractionKey": "su-causeway",
      "latitude": 30.245833,
      "longitude": 120.133472,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "key": "three-pools-mirroring-moon.light-and-reflection",
      "name": "三潭印月的光与倒影",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭印月把小尺度塔形标志、灯光、水面和月色组合成夜间图像。理解它时可以区分实体、灯孔形成的亮点与水中倒影，体会景名如何让多层影像同时成立。"
          }
        ]
      },
      "culturalElementKey": "west-lake-moon-viewing",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q10866444"
    },
    {
      "key": "three-pools-mirroring-moon.cultural-landscape",
      "name": "三潭映月与西湖文化景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "从三潭映月出发，可以把西湖理解为一座持续营造的文化景观：水面、岛屿、石塔、桥岸、植物和题名共同决定观看方式。重点不只是寻找一处“古迹”，而是观察自然与人工如何长期叠合。"
          }
        ]
      },
      "culturalElementKey": "west-lake-cultural-landscape",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "key": "three-pools-mirroring-moon.northern-song",
      "name": "三潭映月的北宋线索",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭石塔的历史线索可追溯到北宋元祐年间的西湖疏浚。现场理解时，可以把三座石塔同时看作水深标志、治理遗存和后来诗意景观的起点，不把今天的岛上园林全部倒推为北宋原貌。"
          }
        ]
      },
      "culturalElementKey": "northern-song-three-pools",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "key": "three-pools-mirroring-moon.su-shi",
      "name": "苏轼：从疏浚到诗意景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "苏轼在杭州任职期间主持西湖疏浚，并以诗文留下对湖山的观看。三潭映月与苏堤可以并读：一条是水利治理和公共工程，一条是诗人如何把治理后的空间转化为可记忆、可传诵的景观。"
          }
        ]
      },
      "culturalElementKey": "su-shi-and-west-lake",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "key": "three-pools-mirroring-moon.bai-juyi",
      "name": "白居易：西湖的唐代诗人传统",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "白居易留下的白堤传统提示我们，西湖的文化积累早于宋代。三潭映月虽然不是白居易营造的遗存，却可以沿着“诗人—水利—游赏”的线索，理解唐宋文人如何参与塑造西湖的文化记忆。"
          }
        ]
      },
      "culturalElementKey": "bai-juyi-and-west-lake",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "key": "three-pools-mirroring-moon.southern-song",
      "name": "南宋临安的景名传统",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“三潭印月”应放入南宋临安形成的西湖题名景观传统中阅读。四字景目把地点、季节、光线和情绪压缩为一句短语，使游湖从移动路线变成一组可吟咏、可绘画、可反复观看的场景。"
          }
        ]
      },
      "culturalElementKey": "southern-song-linan",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.moj.gov.cn/pub/sfbgw/flfggz/flfggzdfzwgz/201006/t20100618_138397.html"
    },
    {
      "key": "three-pools-mirroring-moon.song-aesthetics",
      "name": "宋代山水审美中的虚实",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭映月的魅力不在于“看见三个实体的月亮”，而在于实体石塔、灯孔亮点、月光和水中倒影之间的虚实转换。它提供了一个入口，理解宋代山水审美如何用有限景物生成更大的想象空间。"
          }
        ]
      },
      "culturalElementKey": "song-landscape-aesthetics",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "key": "three-pools-mirroring-moon.garden-framing",
      "name": "桥岸与树影形成的园林取景",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "在三潭映月行走时，桥洞、岸线、树木和亭台会不断改变视线边界。可以把这种经验理解为借景与框景：园林不只陈列对象，也通过路径和遮挡安排观看顺序，让湖山在不同位置呈现不同画面。"
          }
        ]
      },
      "culturalElementKey": "west-lake-garden-framing",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "key": "three-pools-mirroring-moon.xiaoyingzhou",
      "name": "小瀛洲：湖中有岛、岛中有湖",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "小瀛洲把岛外三潭与岛内水面、桥岸和园林路径组合起来，形成“湖中有岛、岛中有湖”的空间层次。三潭映月因此不只是远观三座石塔，也是一段在水面与园林之间转换尺度的行走经验。"
          }
        ]
      },
      "culturalElementKey": "xiaoyingzhou-lake-garden",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "key": "three-pools-mirroring-moon.reunion",
      "name": "从赏月到团圆想象",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "赏月在传统文化中常与团圆和寄情相连。三潭映月把这一情感主题转成空间体验：人在岸上或船上观看，月色、灯影和倒影彼此分离又重新合成，使“月”既是天体，也是被文化命名的共同想象。"
          }
        ]
      },
      "culturalElementKey": "moon-viewing-and-reunion",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "key": "broken-bridge.snow",
      "name": "断桥残雪的观看方式",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "断桥所在的观看不是看桥体本身，而是看雪后黑白灰的湖面：桥面部分融化、部分存留时，桥身像被切开的断面。站在白堤东端，石桥、残雪和北里湖、外西湖的空间层次同时进入画面。"
          }
        ]
      },
      "culturalElementKey": "west-lake-winter-snow",
      "attractionKey": "broken-bridge",
      "latitude": 30.260833,
      "longitude": 120.146944,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/断桥残雪"
    },
    {
      "key": "broken-bridge.whitesnake",
      "name": "断桥与《白蛇传》",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "《白蛇传》把断桥写成许仙与白娘子的相遇、相离与重逢的地点。故事与桥的石拱和湖水的呼应互相投射，使桥既是一座交通构筑，也成为戏曲游湖的舞台。"
          }
        ]
      },
      "culturalElementKey": "legend-of-the-white-snake",
      "attractionKey": "broken-bridge",
      "latitude": 30.260833,
      "longitude": 120.146944,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/断桥"
    },
    {
      "key": "pinghu-autumn-moon.moon",
      "name": "平湖秋月的秋夜月色",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "平湖秋月位于白堤西端的孤山之塘，面向外湖展开。秋夜湖面平静时月亮倒影完整，湖面的尺度成为观看主题。到平台或步道边体会湖、月、倒影三者顺序。"
          }
        ]
      },
      "culturalElementKey": "west-lake-moon-viewing",
      "attractionKey": "pinghu-autumn-moon",
      "latitude": 30.2545,
      "longitude": 120.141306,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/平湖秋月"
    },
    {
      "key": "quyuan-feng-he.lotus",
      "name": "曲院风荷的夏日荷风",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "曲院风荷的荷塘沿湖面展开，盛夏时荷叶与游船同时运动。过曲廊、过桥，荷叶之间不断变换层次，风成为最重要的介质：先体会风，再看叶与光，最后才指认具体植物。"
          }
        ]
      },
      "culturalElementKey": "quyuan-lotus-summer",
      "attractionKey": "quyuan-feng-he",
      "latitude": 30.249287,
      "longitude": 120.133333,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0F6FA"
    },
    {
      "key": "huagang-guan-yu.fish",
      "name": "花港观鱼的池边观看",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "花港观鱼看的是鱼与池、人行与倒影互相交织的关系。站在回廊上让鱼群在池中聚散，再沿池走一圈，体会水底、鱼影与步道的节奏同步，从而理解“观”字包含的活动性。"
          }
        ]
      },
      "culturalElementKey": "huagang-fish-viewing",
      "attractionKey": "huagang-guan-yu",
      "latitude": 30.230233,
      "longitude": 120.139095,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "key": "liulang-wen-ying.spring",
      "name": "柳浪闻莺的春声",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "柳浪闻莺以排柳与鸟鸣闻名，是西湖少见的以听为主的景点。春天站在柳下听鸟鸣与湖浪，向西朝南山、北山两个方向辨认声音来源，把观察从视觉扩展到听觉与季节。"
          }
        ]
      },
      "culturalElementKey": "liulang-wenying-soundscape",
      "attractionKey": "liulang-wen-ying",
      "latitude": 30.240389,
      "longitude": 120.156326,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "key": "shuang-feng-cha-yun.cloud",
      "name": "双峰插云的远观方式",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "双峰插云不宜近看，适合在洪春桥、苏堤等能同时看到南北两峰的远点。云薄薄遮住峰顶时，“插云”的形态最明显——先定方位，再看云雾变化，最后才找山峰的高度。"
          }
        ]
      },
      "culturalElementKey": "shuangfeng-cloud-peaks",
      "attractionKey": "shuang-feng-cha-yun",
      "latitude": 30.247511,
      "longitude": 120.122581,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B025E0"
    },
    {
      "key": "ling-yin-temple.grove",
      "name": "灵隐寺的山林法度",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "灵隐寺的观看不是第一眼看到大殿，而是从入口到殿前越来越静的过程。转崖壁与山泉，中轴建筑与古树交叠，寺院真正把山林当作背景与骨架，观寺需要顺着路径逐层而上。"
          }
        ]
      },
      "culturalElementKey": "lingyin-zen-grove",
      "attractionKey": "ling-yin-temple",
      "latitude": 30.240826,
      "longitude": 120.101406,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0DA1F"
    },
    {
      "key": "ling-yin-temple.grotto",
      "name": "飞来峰的摩崖造像",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "飞来峰在灵隐寺门前溪对岸，岩体上遍布宋元造像。造像是刻在天然岩面上的，沿着洞窟与山径走动，在各个角度仰望，比较岩、泉、寺、塔在视线里的配合，才能体会山体作为“经卷”的属性。"
          }
        ]
      },
      "culturalElementKey": "feilai-grotto-carving",
      "attractionKey": "ling-yin-temple",
      "latitude": 30.240826,
      "longitude": 120.101406,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0DA1F"
    },
    {
      "key": "longjing-village.tea",
      "name": "龙井山村的茶山",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "龙井的泉水与茶相配，茶园与村舍沿坡展开。走到茶山上，体会茶树与山泉的对应，再把视线拉回村落——龙井既是地名也是一种制茶体系，茶山是山林与农事同时成立的场所。"
          }
        ]
      },
      "culturalElementKey": "longjing-tea-terrace",
      "attractionKey": "longjing-village",
      "latitude": 30.218481,
      "longitude": 120.106683,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "key": "hupao-park.spring",
      "name": "虎跑的泉水与茶",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "虎跑的泉池与石崖、亭廊结合，饮用传统让泉水被写进茶文化。看水时先感受流入泉池的节奏，再端杯于亭中试泡，能体会泉水与水的差别；它与龙井一侧共同构成“山水+茶”的连线。"
          }
        ]
      },
      "culturalElementKey": "hupao-spring-tea",
      "attractionKey": "hupao-park",
      "latitude": 30.208087,
      "longitude": 120.1299,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "key": "liu-he-pagoda.river",
      "name": "六和塔与钱塘江",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "六和塔立在钱塘江岸边，塔、江、潮与地平线合成秩序。逐层向上时江面渐远，观塔与观江互证：塔是垂直的度量，江是水平的界面，二者在同一处高差下生成塔和江的关系。"
          }
        ]
      },
      "culturalElementKey": "liuhe-pagoda-river",
      "attractionKey": "liu-he-pagoda",
      "latitude": 30.196338,
      "longitude": 120.131487,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "key": "liu-he-pagoda.tide",
      "name": "六和塔下的观潮",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "钱塘江潮在农历八月前后最盛，江面能被一道高耸水线压过。在六和塔一带远观潮线，先听见声、再看见潮，潮、江、塔与风在彼此呼应；观潮要选择稳定观察点，不必贴近追逐。"
          }
        ]
      },
      "culturalElementKey": "qiantang-tide",
      "attractionKey": "liu-he-pagoda",
      "latitude": 30.196338,
      "longitude": 120.131487,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "key": "xiling-seal.society",
      "name": "西泠印社的孤山空间",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "西泠印社把印章、金石与孤山庭园连成一体，是西湖文人传统的方寸之地。穿过亭廊看湖山，再回看石印与碑刻，体会“方寸之间见天地”的观看方式。"
          }
        ]
      },
      "culturalElementKey": "xiling-seal-art",
      "attractionKey": "xiling-seal",
      "latitude": 30.250279,
      "longitude": 120.139948,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B09LU0"
    },
    {
      "key": "wenlan-pavilion.manuscript-route",
      "name": "文澜阁的四库故事",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "文澜阁是《四库全书》七大书阁之一，咸丰年间损毁后重修，书与阁的命运曲折。早晨光线平射入阁时，书架与叠布透出整个藏书楼的空间层次。"
          }
        ]
      },
      "culturalElementKey": "siku-quanshu-library",
      "attractionKey": "wenlan-pavilion",
      "latitude": 30.253303,
      "longitude": 120.137856,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Wenlan_Pavilion"
    },
    {
      "key": "yue-fei-temple.apple-blossom",
      "name": "岳庙里的祠与柏",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "岳王庙里古柏参天、铁铸秦桧跪像，正殿气场沉雄。从入园到正祠再到殿后墓园，叙事的尺度从纪念广场收进忠烈坟土。"
          }
        ]
      },
      "culturalElementKey": "yue-fei-memorial-culture",
      "attractionKey": "yue-fei-temple",
      "latitude": 30.257778,
      "longitude": 120.126111,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q579874"
    },
    {
      "key": "pinghu-autumn-moon.stone-terrace",
      "name": "平湖秋月的平台与月光",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "平湖秋月有一块伸向湖面的石台，站在石台上，月色从湖面水平灌注进视野。平台把建筑与湖之间的距离压缩到一条石沿，是观看入湖月景的绝佳取景器。"
          }
        ]
      },
      "culturalElementKey": "west-lake-moon-viewing",
      "attractionKey": "pinghu-autumn-moon",
      "latitude": 30.2545,
      "longitude": 120.141306,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/平湖秋月"
    },
    {
      "key": "quirrefeng-he.winter",
      "name": "曲院荷塘的季节另一面",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "曲院风荷秋后荷枯、冬来残荷，看惯了满塘绿荷后转看瘦荷清影：荷塘不只在盛夏抢面，枯荷的线条与雪线同样构景。"
          }
        ]
      },
      "culturalElementKey": "quyuan-lotus-summer",
      "attractionKey": "quyuan-feng-he",
      "latitude": 30.249287,
      "longitude": 120.133333,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0F6FA"
    },
    {
      "key": "huagang-guan-yu.pond-edge-sit",
      "name": "花港观鱼的池边观看",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "花港观鱼的重点在池与人的距离：池边石栏与曲桥让游鱼凑近脚边，重心既在人又在鱼。观察看与被看的视线交换，是一把理解园水关系的钥匙。"
          }
        ]
      },
      "culturalElementKey": "huagang-fish-viewing",
      "attractionKey": "huagang-guan-yu",
      "latitude": 30.230233,
      "longitude": 120.139095,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "key": "liu-he-pagoda.landscape-score",
      "name": "六和塔内外的层次",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "六和塔同时面向江、山与城市：中层看舟、上层见江天。塔内的螺旋扶梯把江岸风景切片成一级级的镜头，为登高者提供不断重组的画面。"
          }
        ]
      },
      "culturalElementKey": "liuhe-pagoda-river",
