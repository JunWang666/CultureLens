      "longitude": 120.133333,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0F6FA"
    },
    {
      "id": "56ebd547-e455-56f9-94a6-cc3b0000b8ca",
      "key": "huagang-guan-yu.fish",
      "name": "花港观鱼的池边观看",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "花港观鱼看的是鱼与池、人行与倒影互相交织的关系。站在回廊上让鱼群在池中聚散，再沿池走一圈，体会水底、鱼影与步道的节奏同步，从而理解“观”字包含的活动性。"
          }
        ]
      },
      "culturalElementId": "7aa489c9-6efc-54da-8486-914cbab0267b",
      "attractionId": "cb8e1614-8af5-5d75-af18-b490c0558dcd",
      "latitude": 30.230233,
      "longitude": 120.139095,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "id": "01ba5046-a3a1-55e7-86a2-c075103ec53e",
      "key": "liulang-wen-ying.spring",
      "name": "柳浪闻莺的春声",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "柳浪闻莺以排柳与鸟鸣闻名，是西湖少见的以听为主的景点。春天站在柳下听鸟鸣与湖浪，向西朝南山、北山两个方向辨认声音来源，把观察从视觉扩展到听觉与季节。"
          }
        ]
      },
      "culturalElementId": "dfeaf81b-a122-5690-a9ae-1c0c8c745c9b",
      "attractionId": "98ea122d-7182-50df-952b-399961d1f0af",
      "latitude": 30.240389,
      "longitude": 120.156326,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "id": "b8e95387-5b9d-537e-80fd-98661e4fa941",
      "key": "shuang-feng-cha-yun.cloud",
      "name": "双峰插云的远观方式",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "双峰插云不宜近看，适合在洪春桥、苏堤等能同时看到南北两峰的远点。云薄薄遮住峰顶时，“插云”的形态最明显——先定方位，再看云雾变化，最后才找山峰的高度。"
          }
        ]
      },
      "culturalElementId": "77347f66-53d0-5e01-a359-01bc66ca8330",
      "attractionId": "adaf1aa2-a082-5e05-8c67-022a131da536",
      "latitude": 30.247511,
      "longitude": 120.122581,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B025E0"
    },
    {
      "id": "bfce9e4c-d355-5f65-a081-c3fc9f9b0c24",
      "key": "ling-yin-temple.grove",
      "name": "灵隐寺的山林法度",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "灵隐寺的观看不是第一眼看到大殿，而是从入口到殿前越来越静的过程。转崖壁与山泉，中轴建筑与古树交叠，寺院真正把山林当作背景与骨架，观寺需要顺着路径逐层而上。"
          }
        ]
      },
      "culturalElementId": "85ea281c-8741-505e-a7f0-62400f5b33ba",
      "attractionId": "a15093b6-3b02-593b-8cf7-6edd42f243f9",
      "latitude": 30.240826,
      "longitude": 120.101406,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0DA1F"
    },
    {
      "id": "3d88bb2c-f79e-51a2-8a95-2c02f9859553",
      "key": "ling-yin-temple.grotto",
      "name": "飞来峰的摩崖造像",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "飞来峰在灵隐寺门前溪对岸，岩体上遍布宋元造像。造像是刻在天然岩面上的，沿着洞窟与山径走动，在各个角度仰望，比较岩、泉、寺、塔在视线里的配合，才能体会山体作为“经卷”的属性。"
          }
        ]
      },
      "culturalElementId": "3ff3b94d-b5d0-5baf-9b3b-cd0480e3d73b",
      "attractionId": "a15093b6-3b02-593b-8cf7-6edd42f243f9",
      "latitude": 30.240826,
      "longitude": 120.101406,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0DA1F"
    },
    {
      "id": "d2c09c13-c1e4-542d-ab3b-bf2e6e326da2",
      "key": "longjing-village.tea",
      "name": "龙井山村的茶山",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "龙井的泉水与茶相配，茶园与村舍沿坡展开。走到茶山上，体会茶树与山泉的对应，再把视线拉回村落——龙井既是地名也是一种制茶体系，茶山是山林与农事同时成立的场所。"
          }
        ]
      },
      "culturalElementId": "1b4ebb4a-6954-580a-bf6d-2fc054de0928",
      "attractionId": "b146d6b3-112d-57a9-a4a8-174fa8396a3f",
      "latitude": 30.218481,
      "longitude": 120.106683,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "id": "17cc31c5-dcdd-5f11-b8c7-ff95938b5928",
      "key": "hupao-park.spring",
      "name": "虎跑的泉水与茶",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "虎跑的泉池与石崖、亭廊结合，饮用传统让泉水被写进茶文化。看水时先感受流入泉池的节奏，再端杯于亭中试泡，能体会泉水与水的差别；它与龙井一侧共同构成“山水+茶”的连线。"
          }
        ]
      },
      "culturalElementId": "e383a049-b7f3-53d5-96fb-301ea2297c49",
      "attractionId": "6c8d8dc6-6499-5aca-b7cf-7b65e8de9068",
      "latitude": 30.208087,
      "longitude": 120.1299,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
