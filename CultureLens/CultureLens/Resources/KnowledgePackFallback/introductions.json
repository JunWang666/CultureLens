    },
    {
      "key": "su-causeway.iodine-bridges",
      "name": "苏堤六桥与移步",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "苏堤由六桥（映波、锁澜、望山、压堤、东浦、跨虹）串起的六处停顿；每过一座桥，湖面与山影随桥孔切出一格新的画面。苏堤真正的『春晓』是一场沿堤而行的步移景异。"
          }
        ]
      },
      "culturalElementKey": "west-lake-causeway-waterworks",
      "attractionKey": "su-causeway",
      "latitude": 30.245833,
      "longitude": 120.133472,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "key": "su-causeway.urn",
      "name": "苏堤的水利与植柳",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "苏堤本来是苏轼挖湖泥筑成，堤上植柳与桃花，既挡浪又护岸，行人的行走与水的治理合而为一。水利营造与湖岸景观在苏堤上是同一条路线。"
          }
        ]
      },
      "culturalElementKey": "su-shi-and-west-lake",
      "attractionKey": "su-causeway",
      "latitude": 30.245833,
      "longitude": 120.133472,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "key": "liulang-wen-ying.evening-feel",
      "name": "柳浪闻莺的黄昏",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "傍晚的柳浪闻莺最懂行人：垂柳沿湖岸压低视线，黄黄昏光线穿过柳丝，把散步道染成一条金色河岸。柳浪与莺啼消歇后，湖面就交给夜月。"
          }
        ]
      },
      "culturalElementKey": "lakeside-old-city-interface",
      "attractionKey": "liulang-wen-ying",
      "latitude": 30.240389,
      "longitude": 120.156326,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "key": "shuang-feng-cha-yun.poetic",
      "name": "双峰插云的诗意远望",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "双峰插云的看点不在登顶，而在从湖岸回望两峰时那种云端相加的意象。诗人们把南北高峰当成一对远山中的句子，一高一下、一深一浅，构出西湖东面的天际线。"
          }
        ]
      },
      "culturalElementKey": "poetic-landscape-naming",
      "attractionKey": "shuang-feng-cha-yun",
      "latitude": 30.247511,
