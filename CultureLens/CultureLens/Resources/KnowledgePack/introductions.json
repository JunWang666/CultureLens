    {
      "id": "4bec0ed5-d50f-519c-adc5-5f8ce3170810",
      "key": "wenlan-pavilion.manuscript-route",
      "name": "文澜阁的四库故事",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "文澜阁是《四库全书》七大书阁之一，咸丰年间损毁后重修，书与阁的命运曲折。早晨光线平射入阁时，书架与叠布透出整个藏书楼的空间层次。"
          }
        ]
      },
      "culturalElementId": "078a4b3d-92f8-54db-97eb-1f7a681d0ca3",
