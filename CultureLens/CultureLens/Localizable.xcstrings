    },
    "沿着一条文化线索连续点亮节点，把零散识别收成可完成的探索路径。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light up nodes along a cultural thread, turning scattered recognitions into a completable path of discovery."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文化の糸に沿ってノードを点灯し、散らばった認識を完了可能な発見の道筋へ変えましょう。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсвечивайте узлы вдоль культурной нити, превращая разрозненные распознавания в завершаемый путь открытия."
          }
        }
      }
    },
    "沿着一条文化线索连续点亮节点。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illuminate connected nodes along a cultural thread."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文化の糸をたどって関連ノードを連続して点灯します。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Освещайте связанные узлы вдоль культурной нити."
          }
        }
      }
    },
    "沿着一条文化线索连续点亮节点。每完成一系，就为你的文化图鉴盖下一枚印章。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illuminate connected nodes along a cultural thread. Each completed series adds a seal to your atlas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文化の糸に沿ってつながるノードを点灯しましょう。シリーズを完了するたびに、あなたのアトラスに印が追加されます。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подсвечивайте связанные узлы вдоль культурной нити. Каждая завершенная серия добавляет печать в ваш атлас."
          }
        }
      }
    },
    "沿着月影、十景、塔影等线索连续点亮节点。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Light up nodes along threads like moon shadows, the Ten Scenes, and pagoda reflections."
