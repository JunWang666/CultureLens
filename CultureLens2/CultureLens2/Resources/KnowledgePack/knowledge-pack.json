  "introductions": [
    {
      "key": "leifeng-pagoda.lake-landscape",
      "name": "雷峰塔的湖山位置",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "从西湖南岸看，雷峰塔以较厚重的塔身压住夕照山的轮廓。它适合从湖面和远岸辨认，重点不只是近看细部，而是观察塔、山与开阔水面的比例关系。"
          }
        ]
      },
      "culturalElementKey": "west-lake-pagoda-landscape",
      "attractionKey": "leifeng-pagoda",
      "latitude": 30.233889,
      "longitude": 120.145,
      "coordinateSourceUrl": "https://fr.wikipedia.org/wiki/Pagode_de_Leifeng"
    },
    {
      "key": "leifeng-pagoda.evening-glow",
      "name": "雷峰夕照的观看提示",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“雷峰夕照”把地点与傍晚光线绑定。理解这一名称时，可以留意低角度日光如何强调塔的剪影，以及湖面亮度变化怎样把塔从山体背景中分离出来。"
          }
        ]
      },
      "culturalElementKey": "west-lake-ten-scenes",
      "attractionKey": "leifeng-pagoda",
      "latitude": 30.233889,
      "longitude": 120.145,
      "coordinateSourceUrl": "https://fr.wikipedia.org/wiki/Pagode_de_Leifeng"
    },
    {
      "key": "baochu-pagoda.mountain-silhouette",
      "name": "宝石山上的保俶塔",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "保俶塔塔身瘦削，位于宝石山脊线上。与雷峰塔相比，它更像一枚细长的方向标；从湖东和北岸远望时，塔的价值主要体现在清晰轮廓与山势的对照。"
          }
        ]
      },
      "culturalElementKey": "west-lake-pagoda-landscape",
      "attractionKey": "baochu-pagoda",
      "latitude": 30.263333,
      "longitude": 120.143611,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q977249"
    },
    {
      "key": "jingci-temple.temple-and-lake",
      "name": "净慈寺与西湖南岸佛教空间",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "净慈寺位于西湖南岸山麓，寺院、山体与湖边道路距离很近。到这里可以观察宗教空间并非远离城市，而是与游湖路线和日常交通持续交叠。"
          }
        ]
      },
      "culturalElementKey": "west-lake-buddhist-culture",
      "attractionKey": "jingci-temple",
      "latitude": 30.23113,
      "longitude": 120.14434,
      "coordinateSourceUrl": "https://mapcarta.com/N4427428610"
    },
    {
      "key": "jingci-temple.evening-bell",
      "name": "南屏晚钟的听觉景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“南屏晚钟”把声音也纳入西湖景观。它提醒人们，传统游赏并不只靠视觉：钟声的传播距离、山体回响和傍晚环境的安静程度，都会改变对地点的感受。"
          }
        ]
      },
      "culturalElementKey": "west-lake-ten-scenes",
      "attractionKey": "jingci-temple",
      "latitude": 30.23113,
      "longitude": 120.14434,
      "coordinateSourceUrl": "https://mapcarta.com/N4427428610"
    },
    {
      "key": "yue-fei-temple.memorial-space",
      "name": "岳王庙的纪念空间",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "岳王庙的参观重点不仅是识别某一座殿或墓，而是理解入口、祠庙、碑刻与墓园怎样组织出逐步强化的纪念秩序。空间路线本身就在引导态度和情绪。"
          }
        ]
      },
      "culturalElementKey": "yue-fei-memorial-culture",
      "attractionKey": "yue-fei-temple",
      "latitude": 30.257778,
      "longitude": 120.126111,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q579874"
    },
    {
      "key": "wenlan-pavilion.imperial-library",
      "name": "文澜阁的藏书楼身份",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "文澜阁位于孤山文化设施密集的环境中。它的意义不只在园林外观，还在于作为《四库全书》藏书楼，把国家编纂工程落实为具体的收藏、保管与阅读空间。"
          }
        ]
      },
      "culturalElementKey": "siku-quanshu-library",
      "attractionKey": "wenlan-pavilion",
      "latitude": 30.253303,
      "longitude": 120.137856,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Wenlan_Pavilion"
    },
    {
      "key": "su-causeway.waterworks-and-walking",
      "name": "苏堤的水利与步行尺度",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "苏堤把疏浚、水面分隔和跨湖交通结合在一起。步行时可以留意桥与堤的交替：平直堤面提供连续方向，桥面抬高视点，让两侧湖面重新展开。"
          }
        ]
      },
      "culturalElementKey": "west-lake-causeway-waterworks",
      "attractionKey": "su-causeway",
      "latitude": 30.245833,
      "longitude": 120.133472,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "key": "su-causeway.spring-dawn",
      "name": "苏堤春晓的时间感",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“苏堤春晓”强调早春与清晨，而不是固定建筑。堤上植物、薄雾、低亮度水面和逐渐苏醒的行人活动，共同构成这处景名的时间感。"
          }
        ]
      },
      "culturalElementKey": "west-lake-ten-scenes",
      "attractionKey": "su-causeway",
      "latitude": 30.245833,
      "longitude": 120.133472,
      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "key": "three-pools-mirroring-moon.light-and-reflection",
      "name": "三潭印月的光与倒影",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭印月把小尺度塔形标志、灯光、水面和月色组合成夜间图像。理解它时可以区分实体、灯孔形成的亮点与水中倒影，体会景名如何让多层影像同时成立。"
          }
        ]
      },
      "culturalElementKey": "west-lake-moon-viewing",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.wikidata.org/wiki/Q10866444"
    },
    {
      "key": "three-pools-mirroring-moon.cultural-landscape",
      "name": "三潭映月与西湖文化景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "从三潭映月出发，可以把西湖理解为一座持续营造的文化景观：水面、岛屿、石塔、桥岸、植物和题名共同决定观看方式。重点不只是寻找一处“古迹”，而是观察自然与人工如何长期叠合。"
          }
        ]
      },
      "culturalElementKey": "west-lake-cultural-landscape",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "key": "three-pools-mirroring-moon.northern-song",
      "name": "三潭映月的北宋线索",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭石塔的历史线索可追溯到北宋元祐年间的西湖疏浚。现场理解时，可以把三座石塔同时看作水深标志、治理遗存和后来诗意景观的起点，不把今天的岛上园林全部倒推为北宋原貌。"
          }
        ]
      },
      "culturalElementKey": "northern-song-three-pools",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "key": "three-pools-mirroring-moon.su-shi",
      "name": "苏轼：从疏浚到诗意景观",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "苏轼在杭州任职期间主持西湖疏浚，并以诗文留下对湖山的观看。三潭映月与苏堤可以并读：一条是水利治理和公共工程，一条是诗人如何把治理后的空间转化为可记忆、可传诵的景观。"
          }
        ]
      },
      "culturalElementKey": "su-shi-and-west-lake",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "key": "three-pools-mirroring-moon.bai-juyi",
      "name": "白居易：西湖的唐代诗人传统",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "白居易留下的白堤传统提示我们，西湖的文化积累早于宋代。三潭映月虽然不是白居易营造的遗存，却可以沿着“诗人—水利—游赏”的线索，理解唐宋文人如何参与塑造西湖的文化记忆。"
          }
        ]
      },
      "culturalElementKey": "bai-juyi-and-west-lake",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "key": "three-pools-mirroring-moon.southern-song",
      "name": "南宋临安的景名传统",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "“三潭印月”应放入南宋临安形成的西湖题名景观传统中阅读。四字景目把地点、季节、光线和情绪压缩为一句短语，使游湖从移动路线变成一组可吟咏、可绘画、可反复观看的场景。"
          }
        ]
      },
      "culturalElementKey": "southern-song-linan",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.moj.gov.cn/pub/sfbgw/flfggz/flfggzdfzwgz/201006/t20100618_138397.html"
    },
    {
      "key": "three-pools-mirroring-moon.song-aesthetics",
      "name": "宋代山水审美中的虚实",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "三潭映月的魅力不在于“看见三个实体的月亮”，而在于实体石塔、灯孔亮点、月光和水中倒影之间的虚实转换。它提供了一个入口，理解宋代山水审美如何用有限景物生成更大的想象空间。"
          }
        ]
      },
      "culturalElementKey": "song-landscape-aesthetics",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "key": "three-pools-mirroring-moon.garden-framing",
      "name": "桥岸与树影形成的园林取景",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "在三潭映月行走时，桥洞、岸线、树木和亭台会不断改变视线边界。可以把这种经验理解为借景与框景：园林不只陈列对象，也通过路径和遮挡安排观看顺序，让湖山在不同位置呈现不同画面。"
          }
        ]
      },
      "culturalElementKey": "west-lake-garden-framing",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://whc.unesco.org/en/list/1334/"
    },
    {
      "key": "three-pools-mirroring-moon.xiaoyingzhou",
      "name": "小瀛洲：湖中有岛、岛中有湖",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "小瀛洲把岛外三潭与岛内水面、桥岸和园林路径组合起来，形成“湖中有岛、岛中有湖”的空间层次。三潭映月因此不只是远观三座石塔，也是一段在水面与园林之间转换尺度的行走经验。"
          }
        ]
      },
      "culturalElementKey": "xiaoyingzhou-lake-garden",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    },
    {
      "key": "three-pools-mirroring-moon.reunion",
      "name": "从赏月到团圆想象",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "赏月在传统文化中常与团圆和寄情相连。三潭映月把这一情感主题转成空间体验：人在岸上或船上观看，月色、灯影和倒影彼此分离又重新合成，使“月”既是天体，也是被文化命名的共同想象。"
          }
        ]
      },
      "culturalElementKey": "moon-viewing-and-reunion",
      "attractionKey": "three-pools-mirroring-moon",
      "latitude": 30.240833,
      "longitude": 120.140278,
      "coordinateSourceUrl": "https://www.ehangzhou.gov.cn/2018-06/14/c_271616.htm"
    }
  ]
