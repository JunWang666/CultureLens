      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "id": "47971eeb-55c2-52c6-a9c5-b81d014e4cf0",
      "key": "xiling-seal.studio-sign",
      "name": "西泠印社的嵌印与篆刻",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "西泠印社以研究金石篆刻闻名，社内摩崖与嵌印遍布孤山。从印谱到拓片，社里的观看方式是中式的‘认字’：把湖山读成一枚枚可刻的篆印。"
          }
        ]
      },
      "culturalElementId": "e0f6d64b-c019-542c-a6fc-859f6f94ffd0",
      "attractionId": "8bd79e27-bcb1-51b9-b97e-bc219ae6aea8",
      "latitude": 30.250279,
      "longitude": 120.139948,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B09LU0"
    },
    {
      "id": "b8c247e5-eb36-5997-a86c-386330ab3b1e",
      "key": "jingci-temple.evening-bell-tone",
      "name": "净慈寺的晚钟",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "净慈寺是南屏晚钟的所在地，寺内钟楼的大钟在黄昏敲响时，钟声贴着南屏山的崖壁滚向湖面。听钟的位置常选在湖心，钟在山与湖之间来回，是西湖最慢的一件声音景观。"
          }
        ]
      },
      "culturalElementId": "db6089df-2ae1-508c-b2bc-e8316c287306",
      "attractionId": "972bbaf8-1b55-5043-8d74-d40856ab6492",
      "latitude": 30.23113,
      "longitude": 120.14434,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "id": "6a5a14e5-0045-5175-820d-bdc0b4069dd4",
      "key": "leifeng-pagoda.sunlight-and-shadow",
      "name": "雷峰夕照的光线时刻",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "雷峰塔受两:一亮一暗。阳光贴塔身以西的斜光拉出长影，塔影一直伸进湖面，与湖水波光相叠，让夕照从塔身一路浸到对岸。色温转橙的那一刻，是观看这座塔的最佳窗口。"
          }
        ]
      },
      "culturalElementId": "359c601d-38fc-5368-ae98-929ad425dc77",
      "attractionId": "4019a709-1d10-5c3c-80fa-b97ebf90dd50",
      "latitude": 30.233889,
      "longitude": 120.145,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/雷峰塔"
    },
    {
      "id": "7b494238-abd6-57fd-b74a-66da3c92ecf0",
      "key": "broken-bridge.snow-again",
      "name": "断桥残雪与桥的名字",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "为什么叫断桥？雪后阳光先到桥面北坡，露出碧绿的青石与雪线忽断，或指向段家桥的谐音。两种解释都成立：文字与景色的偶然重叠，把一座普通的低桥写进修辞史。"
          }
        ]
      },
      "culturalElementId": "7f3f6526-7e2a-5d1e-a8bd-a68fcc2ce405",
      "attractionId": "29584556-38e5-5478-b694-c4da40593c03",
      "latitude": 30.260833,
      "longitude": 120.146944,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/断桥"
    },
    {
      "id": "0a828c91-bc8f-57f1-b609-8d660a19bf4c",
      "key": "pinghu-autumn-moon.platform",
      "name": "平湖秋月的平台与御碑",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "平湖秋月刻康熙题字与御碑耸立，面对湖心的平台让月光水平涌入。月到中秋最亮，平台的石栏正好把月光截成一个观众的框，人能进入的画面里。"
          }
        ]
      },
      "culturalElementId": "4b726f27-9a01-576f-b07f-0bf3ddca1a64",
      "attractionId": "52e6eb90-2187-5be7-872a-41651bfc9bb4",
      "latitude": 30.2545,
      "longitude": 120.141306,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/平湖秋月"
    },
    {
      "id": "e5fc3d65-d4b4-55b6-ab81-07e90644458a",
      "key": "yue-fei-temple.entrance-border",
      "name": "岳庙前广场的边界",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "岳庙前广场以两行松柏和石羊守望着外围，庙门朝西湖方向微微偏向，把祠的空间与湖岸的日常隔成两层：外面车马，里面凛冽。门与栏杆之间是忠烈祠礼仪感的起点。"
          }
        ]
      },
      "culturalElementId": "14e0dc6d-21b1-5512-ae11-f226f60b7d8d",
      "attractionId": "c89af010-e4a1-5d1c-a0df-54f116f748f5",
      "latitude": 30.257778,
      "longitude": 120.126111,
      "coordinateSourceUrl": "https://en.wikipedia.org/wiki/Yue_F%C3%A4ng_Tempel"
    },
    {
      "id": "27813375-1a7e-59f0-98ed-af0264b7106c",
      "key": "quyuan-fenghe.moon-of-summer",
      "name": "曲院风荷的夏日纵深",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "盛夏曲院风荷里最凉快的不是水，而是荷影屏蔽的斜光线。沿着回廊走到池畔，荷花把湖面占全，风从鳞山入，把一阵阵荷香送过眼前的绿海。"
          }
        ]
      },
      "culturalElementId": "9144e185-d474-5c5d-a39b-0ab00af80c0d",
      "attractionId": "660de823-9bec-50ac-a588-f5f5387dc225",
      "latitude": 30.249287,
      "longitude": 120.133333,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0F6FA"
    },
    {
      "id": "a2d58182-ff1d-53f8-aca6-79bd0509eb4d",
      "key": "yue-fei-temple.alley",
      "name": "岳望着孤山的公共绿地",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "岳庙之东利用山脚斜坡铺了一片公共绿地，下班后孩子与老人混在一起放风筝。祠堂的庄严与公园的日常只隔一道院墙，是西湖边少有的古庙对人的拉近之处。"
          }
        ]
      },
      "culturalElementId": "680531f9-9b60-54b9-a615-9bbfd6d5260c",
      "attractionId": "c89af010-e4a1-5d1c-a0df-54f116f748f5",
      "latitude": 30.257778,
      "longitude": 120.126111,
      "coordinateSourceUrl": "https://zh.wikipedia.org/zh-cn/岳王庙"
    },
    {
      "id": "51e11c6d-7782-5d5d-afcd-017d468cd0f9",
      "key": "ling-yin-temple.kai-after-rain",
      "name": "雨后的灵隐山气",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "灵隐寺在飞来峰与灵隐峰之间夹出一线，雨后雾从峰腰升起，寺瓦与香氛就埋进湿润的山气里。这一带的湿润与青苔使佛寺斯地显得古老而近山，是山中寺院的呼吸节奏。"
          }
        ]
      },
      "culturalElementId": "85ea281c-8741-505e-a7f0-62400f5b33ba",
      "attractionId": "a15093b6-3b02-593b-8cf7-6edd42f243f9",
      "latitude": 30.240826,
      "longitude": 120.101406,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B0E7F4"
    },
    {
      "id": "c82148e5-edd8-57a7-9c90-afa3c5571261",
      "key": "xiling-seal.duan-po",
      "name": "西泠印社的山石与摩崖",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "西泠印社以摩崖刻石布满孤山西麓，社名「西泠」来自冷泉与林社的旧名。沿着石阶上溯，摩崖像把篆刻史展开成一条立体的路，走完就到顶上的竹阁。"
          }
        ]
      },
      "culturalElementId": "e0f6d64b-c019-542c-a6fc-859f6f94ffd0",
      "attractionId": "8bd79e27-bcb1-51b9-b97e-bc219ae6aea8",
      "latitude": 30.250279,
      "longitude": 120.139948,
      "coordinateSourceUrl": "https://ditu.amap.com/place/B023B09LU0"
    },
    {
      "id": "bd418a18-16b8-584f-a6f2-58aee0e90e5f",
      "key": "huxinting.islet",
      "name": "湖心亭的岛中亭",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "湖心亭浮于外西湖中心，四周环水、环水皆山。乘船或隔湖远望，亭子像是湖面上的中心标记；登上小岛环望，五片湖面与岸上青山同时展开，是把握西湖整体格局的枢纽。"
          },
          {
            "type": "paragraph",
            "text": "湖心亭位于杭州西湖之上，旧为湖心寺，是中国四大名亭之一；湖心亭环岛皆水，环水皆山。"
          },
          {
            "type": "paragraph",
            "text": "湖心平眺被列为清西湖十八景之一。"
          }
        ]
      },
      "culturalElementId": "6836d943-c2ca-5696-8cd9-7ba71db683be",
      "attractionId": "284e682e-bc9a-53d7-9bff-2d9599d90ac5",
      "latitude": 30.2475,
      "longitude": 120.144
    },
    {
      "id": "905b61f5-2ed8-578f-8462-fce221a9bc80",
      "key": "huxinting.snow",
      "name": "湖心亭看雪的冬日",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "雪后的湖心亭是最接近古代文人意境的位置。放眼四望，白雪覆盖的湖岸与黛色远山在水平面上相叠，亭中人的视野被推向极远的边界。"
          },
          {
            "type": "paragraph",
            "text": "明人张岱曾留下《湖心亭看雪》一文，这篇短文所写的孤亭、长堤与湖上影子的景象，正是从这处环水位置获得的观察。"
          }
        ]
      },
      "culturalElementId": "7f3f6526-7e2a-5d1e-a8bd-a68fcc2ce405",
      "attractionId": "284e682e-bc9a-53d7-9bff-2d9599d90ac5",
      "latitude": 30.2475,
      "longitude": 120.144
    },
    {
      "id": "a0c8fcfa-142a-5c33-b47e-f7c16f34e297",
      "key": "yang-gong-causeway.history",
      "name": "杨公堤的明代疏浚",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "杨公堤在西里湖西侧，路面平缓、桥洞低矮，堤两侧水面开阔却比外西湖幽静。步行时可以对比它和苏堤的节奏差别，体会一条由疏浚泥土堆筑的长堤如何在水中显出边界。"
          },
          {
            "type": "paragraph",
            "text": "杨公堤与苏堤、白堤并称为“西湖三堤”，原称作西山路，位于西湖西侧西里湖上，北起仁寿山、南至赤山埠。"
          },
          {
            "type": "paragraph",
            "text": "杨公堤为明朝正德三年（1508年）在杭州知府杨孟瑛的主持下修成，故而得名。"
          }
        ]
      },
      "culturalElementId": "9600a3eb-78a4-5bd0-bb33-fc2578bb724b",
      "attractionId": "a9155563-096d-57ba-affb-4c0544a3f559",
      "latitude": 30.232,
      "longitude": 120.129
    },
    {
      "id": "d52916cf-0016-5499-9005-61fce2cca353",
      "key": "yang-gong-causeway.six-bridges",
      "name": "杨公堤的里六桥",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "杨公堤原与苏堤平行，西进工程后恢复的“里六桥”对应苏堤六桥。走桥过水时留意桥名与桥位的呼应，体会两堤六桥相互对应的格局。"
          },
          {
            "type": "paragraph",
            "text": "杨公堤走向基本平行于苏堤；在西湖西进工程中恢复了相对于苏堤的“里六桥”：环碧、流金、卧龙、隐秀、景行和浚源。"
          }
        ]
      },
      "culturalElementId": "085b790e-08f7-5811-8073-8c996202b225",
      "attractionId": "a9155563-096d-57ba-affb-4c0544a3f559",
      "latitude": 30.232,
      "longitude": 120.129
    },
    {
      "id": "e995aeb0-b06a-50bb-b604-13d50c24d252",
      "key": "baoshi-hill.cinnabar-glow",
      "name": "宝石山的赭色霞光",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "清晨朝阳或傍晚落日的时分，站在北山一带看宝石山，山岩会在光线下显出赭红色，这就是“宝石流霞”。颜色来自山体本身，适合选择逆光或侧光的角度观察。"
          },
          {
            "type": "paragraph",
            "text": "宝石山山体属火成岩中的流纹岩和凝灰岩，含氧化铁，因而山岩呈赭红色，尤其在清晨朝阳升起或傍晚落日西下时更为明显，因而被称为宝石山；“宝石流霞”被列为新西湖十景之一。"
          }
        ]
      },
      "culturalElementId": "5fc1ab91-dc4c-5d3c-b9d0-ebf7a90bce6e",
      "attractionId": "1634f4e0-c8df-5ffb-98af-d7e44e3e0b0e",
      "latitude": 30.2635,
      "longitude": 120.1435
    },
    {
      "id": "0da91cb6-0dc0-5638-a1dd-1fd0283a3a4e",
      "key": "baoshi-hill.twin-tower-view",
      "name": "宝石山上的保俶塔视点",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "宝石山是观看西湖全景与双塔对景的位置：南临西湖，山顶立保俶塔，隔湖与南岸雷峰塔相望。登顶回望，一湖映双塔的南北构图尽收眼底。"
          },
          {
            "type": "paragraph",
            "text": "宝石山是杭州西湖北侧的一座小山，南临西湖，西面是葛岭，是观看西湖美景的佳处；山顶建有造型独特的古塔保俶塔，是西湖风景区的标志之一。"
          },
          {
            "type": "paragraph",
            "text": "保俶塔位于宝石山山顶，为西湖风景区标志之一，2013年成为全国重点文物保护单位。"
          }
        ]
      },
      "culturalElementId": "5288e0c4-1ac5-5312-a416-38c9df3405d1",
      "attractionId": "1634f4e0-c8df-5ffb-98af-d7e44e3e0b0e",
      "latitude": 30.2635,
      "longitude": 120.1435
    },
    {
      "id": "e93d185d-373e-5403-97ad-646543632d79",
      "key": "gushan-island.not-alone",
      "name": "孤山不孤",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "孤山是外西湖中的一座天然岛，东西分别以白堤和西泠桥与湖岸相连。从断桥沿白堤向西走，或自西泠桥上回望，可以同时看到岛、桥、湖三者如何连成一体。"
          },
          {
            "type": "paragraph",
            "text": "孤山位于北侧外西湖中，海拔35米，面积约0.22平方公里，为栖霞岭的支脉，也是西湖中最大的天然岛屿；“孤山不孤”与“断桥不断”“长桥不长”并称西湖三怪。"
          }
        ]
      },
      "culturalElementId": "d0352861-3d2c-5301-a662-cd042e449e6a",
      "attractionId": "efbadb98-a165-5a95-9b5b-fb7f22a91aec",
      "latitude": 30.254,
      "longitude": 120.139
    },
    {
      "id": "995cf02a-62f4-5818-b118-f3c830bcc44a",
      "key": "gushan-island.hermitage",
      "name": "孤山的林逋与隐逸",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "孤山东北角的放鹤亭是纪念林逋的位置，亭子面向湖面，是体会“梅妻鹤子”生活方式的安静角落。亭前看梅、亭上望湖，孤山的文人气息由此展开。"
          },
          {
            "type": "paragraph",
            "text": "放鹤亭在孤山东北角，为纪念宋代以“梅妻鹤子”闻名的林逋而建；宋代在孤山隐居的林逋留下了“疏影横斜水清浅，暗香浮动月黄昏”的名句，灵峰、孤山和西溪是古来杭州赏梅的三大胜地。"
          }
        ]
      },
      "culturalElementId": "95eb4f3a-7a95-570d-bae0-a0987c334967",
      "attractionId": "efbadb98-a165-5a95-9b5b-fb7f22a91aec",
      "latitude": 30.254,
      "longitude": 120.139
    },
    {
      "id": "be91e8f9-6185-5c69-929d-601af26c788c",
      "key": "qianwang-temple.wuyue",
      "name": "钱王祠与吴越国",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "钱王祠位于西湖东岸柳浪闻莺公园内。从湖滨一侧步入，殿宇、献殿、碑亭层层展开，是理解吴越国与西湖渊源的核心空间，适合在祠内外对照湖山来看。"
          },
          {
            "type": "paragraph",
            "text": "钱王祠供奉吴越国三世五代国王，原称表忠观，清代以后通称为钱王祠。"
          },
          {
            "type": "paragraph",
            "text": "宋熙宁十年（1077年）十月，于西湖东岸建“表忠观”以纪念吴越国王钱镠，苏轼并作《表忠观碑记》。"
          }
        ]
      },
      "culturalElementId": "d4218a8d-f8be-5b37-bf25-a4e32d7c28cf",
      "attractionId": "91998805-9ab0-5d8c-8a61-e59a5ef7a8cf",
      "latitude": 30.245,
      "longitude": 120.15305556
    },
    {
      "id": "a6d50f08-b33b-5d85-a445-9286e120f362",
      "key": "qianwang-temple.steles",
      "name": "表忠观碑与御题",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "祠内碑刻是参观重点。细读《表忠观碑记》的书法与文辞，再看清康熙、乾隆两代的御题匾额，可以感受到吴越国功业在后世文字中的两种呈现。"
          },
          {
            "type": "paragraph",
            "text": "苏轼撰书的《表忠观碑记》是宋代书法史上的名碑；清代康熙帝、乾隆帝在此留有“保障江山”和“忠顺遗庥”等御题。"
          }
        ]
      },
      "culturalElementId": "89a21706-5676-56aa-ab3c-6ab2b48991d8",
