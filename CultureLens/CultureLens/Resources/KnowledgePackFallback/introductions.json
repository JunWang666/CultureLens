    },
    {
      "key": "pinghu-autumn-moon.platform",
      "name": "平湖秋月的平台与御碑",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "平湖秋月刻康熙题字与御碑耸立，面对湖心的平台让月光水平涌入。月到中秋最亮，平台的石栏正好把月光截成一个观众的框，人能进入的画面里。"
          }
        ]
      },
      "culturalElementKey": "mid-autumn-west-lake",
      "attractionKey": "pinghu-autumn-moon",
      "latitude": 30.2545,
