PORT=8080
MOCK_RECOGNITION=true
DATABASE_URL=postgres://culturelens_app:replace-me@127.0.0.1:5432/culturelens?sslmode=disable
# Configure this server-only database URL to enable /admin and /v1/admin/*.
# CULTURELENS_ADMIN_DATABASE_URL=postgres://culturelens_editor:replace-me@127.0.0.1:5432/culturelens?sslmode=disable
GOOGLE_AI_STUDIO_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_AI_STUDIO_API_KEYS=key-1,key-2,key-3
CULTURELENS_VISION_MODEL=gemini-3.6-flash
CULTURELENS_PROMPT_VERSION=recognition-v5
CULTURELENS_SCHEMA_VERSION=provider-recognition-v5
CULTURELENS_PROMPT_PATH=prompts/recognition/v5.txt
CULTURELENS_SCHEMA_PATH=prompts/recognition/v5.schema.json
