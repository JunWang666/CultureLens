          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鼎の用途は煮炊きを超え、しだいに礼制と権力秩序の一部となりました。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
