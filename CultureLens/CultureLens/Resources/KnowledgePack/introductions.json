      "coordinateSourceUrl": "https://commons.wikimedia.org/wiki/Category:Su_Causeway"
    },
    {
      "id": "becf7b65-8484-566d-bb06-acc13b37aef7",
      "key": "liulang-wen-ying.evening-feel",
      "name": "柳浪闻莺的黄昏",
      "introduction": {
        "schemaVersion": 1,
        "blocks": [
          {
            "type": "paragraph",
            "text": "傍晚的柳浪闻莺最懂行人：垂柳沿湖岸压低视线，黄黄昏光线穿过柳丝，把散步道染成一条金色河岸。柳浪与莺啼消歇后，湖面就交给夜月。"
          }
        ]
      },
      "culturalElementId": "680531f9-9b60-54b9-a615-9bbfd6d5260c",
